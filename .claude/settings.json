{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(npm audit fix --force *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(scripts/release.sh *)",
      "Bash(./scripts/release.sh *)",
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./**/.env.*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/hooks/guard-bash.py\" --tool claude",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/hooks/docs-touch.py\" --hook",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
