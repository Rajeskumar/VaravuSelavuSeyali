# Copy to qa/.env and adjust. Never commit real secrets or this file with values filled in.

# --- Targets ---
# Where the web app under test is served.
BASE_URL=http://localhost:3000
# Where the backend API under test is served.
API_BASE_URL=http://localhost:8080
# Read-only smoke target — never written to unless ALLOW_PROD_WRITES=true.
PROD_BASE_URL=https://expense.cerebroos.com
# The backend lives on a separate subdomain in prod.
PROD_API_BASE_URL=https://trackspense-api.cerebroos.com

# Same Postgres the local backend under test is running against (see
# scripts/bootstrap-local-db.sh's output). Used ONLY to mark the QA personas
# email-verified after registering them — see e2e/setup/global.setup.ts and
# scripts/verify_qa_users.py for why this is necessary (group actions require a
# verified email, and QA has no real SMTP to click a verification link with).
# Leave unset and group tests will fail with a clear 403 rather than this step failing.
QA_DATABASE_URL=postgresql://trackspense_qa:trackspense_qa_pass@localhost:5434/trackspense_qa

# --- QA test users ---
# Shared password for the QA personas the framework provisions via the API.
# Must satisfy the backend's own rule: 8-72 characters.
QA_USER_PASSWORD=Qa_E2E_Passw0rd!

# --- Safety ---
# Hard gate: write operations (create/update/delete via UI or API helpers) refuse
# to run unless BASE_URL/API_BASE_URL look local, UNLESS this is explicitly "true".
# Leave this false. It exists so prod-smoke can never accidentally mutate prod data.
ALLOW_PROD_WRITES=false

# Set automatically by GitHub Actions; leave unset locally.
CI=
