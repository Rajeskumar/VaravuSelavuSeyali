{
  "expo": {
    "name": "TrackSpense",
    "slug": "varavu-selavu-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "trackspense",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.varavuselavumobile",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "This app uses your local network to connect to the development server while building.",
        "NSBonjourServices": [
          "_dev._tcp",
          "_http._tcp"
        ]
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "pan",
      "allowBackup": false,
      "icon": "./assets/android-icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-icon-background.png"
      },
      "package": "com.anonymous.varavuselavumobile",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "trackspense",
              "host": "join",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "imageWidth": 200
        }
      ],
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "TrackSpense uses your photos to scan a receipt.",
          "cameraPermission": "TrackSpense uses your camera to scan a receipt.",
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker",
      "./withDisablePush",
      "expo-font",
      "expo-secure-store",
      "expo-status-bar",
      "./withSceneLifecycle"
    ]
  }
}
