{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "certainty": {
            "enum": [
              "Confirmed",
              "Suspected",
              "Improvement"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "open",
              "fixed",
              "accepted",
              "dismissed"
            ]
          },
          "verification_evidence": {
            "type": "string"
          },
          "waiver": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "owner": {
                    "type": "string",
                    "minLength": 1
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  },
                  "expires": {
                    "type": "string",
                    "format": "date"
                  },
                  "reference": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "owner",
                  "reason",
                  "expires",
                  "reference"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "id",
          "severity",
          "certainty",
          "summary",
          "owner",
          "source",
          "status",
          "verification_evidence",
          "waiver"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "findings"
  ],
  "additionalProperties": false
}
