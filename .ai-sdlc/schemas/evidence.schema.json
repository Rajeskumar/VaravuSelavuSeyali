{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "skipped"
            ]
          },
          "snapshot": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "environment": {
            "type": "string",
            "minLength": 1
          },
          "command_or_method": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "recorded_at": {
            "type": "string",
            "format": "date-time"
          },
          "acceptance_criteria": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "status",
          "snapshot",
          "environment",
          "command_or_method",
          "source",
          "recorded_at",
          "acceptance_criteria"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "results"
  ],
  "additionalProperties": false
}
