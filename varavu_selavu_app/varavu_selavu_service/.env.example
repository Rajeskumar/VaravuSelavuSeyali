# Example .env for TrackSpense Service (backend)
# Copy to .env and fill in values as needed. Do NOT commit real secrets.

# --- App & Environment ---
PROJECT_NAME="TrackSpense Service"
VERSION="1.0.0"
DEBUG=true
# local | production
ENVIRONMENT=local

# --- CORS ---
CORS_ALLOW_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000","https://varavu-selavu-frontend-952416556244.us-central1.run.app"]'

# --- Analysis Service ---
ANALYSIS_CACHE_TTL_SEC=60

# --- Chat Providers ---
# OpenAI (used when provider=openai in chat)
OPENAI_API_KEY=
# Optional override (defaults to gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SEC=300

# Gemini (used for chat, categorization, and receipt OCR)
GEMINI_API_KEY=
# Optional override (defaults to gemini-2.5-flash)
OCR_MODEL=gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash

# Ollama (used when ENVIRONMENT=local)
OLLAMA_BASE_URL=http://localhost:11434
# Optional override (defaults to gpt-oss:20b)
OLLAMA_MODEL=
# Request timeout (seconds)
OLLAMA_TIMEOUT_SEC=300

# --- Google Sheets / GCP ---
# Path to your service account JSON (local dev)
GOOGLE_APPLICATION_CREDENTIALS=
# Set by Cloud Run automatically (leave empty locally)
K_SERVICE=

# Remote MCP (same backend, /mcp). Full setup: docs/mcp-setup-and-deployment.md
# Separate ES256 P-256 private PEM supplied through the environment / Secret Manager.
# Do not paste a real private key into this example or reuse JWT_SECRET.
MCP_ENABLED=false
MCP_WRITES_ENABLED=false
MCP_ISSUER=https://trackspense-api.cerebroos.com
MCP_RESOURCE_URL=https://trackspense-api.cerebroos.com/mcp
MCP_TOKEN_SIGNING_KEY=
MCP_PREVIOUS_VERIFY_KEYS=[]
MCP_CIMD_ALLOWED_HOSTS=[]
MCP_ALLOWED_ORIGINS=[]
MCP_APPROVAL_HOURS=24
# Writes also require: python scripts/mcp_admin.py global writes
